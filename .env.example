# TCGPlayer API (https://developer.tcgplayer.com/)
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=

# eBay API (https://developer.ebay.com/)
EBAY_APP_ID=
EBAY_CERT_ID=

# Pokemon TCG API (https://pokemontcg.io/) - optional, increases rate limit
POKEMON_TCG_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./pokemon_tcg.db

# App
CORS_ORIGINS=["http://localhost:5173"]
PRICE_UPDATE_INTERVAL_MINUTES=60
CACHE_TTL_SECONDS=300
